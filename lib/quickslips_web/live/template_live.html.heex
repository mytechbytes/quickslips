<Layouts.app flash={@flash} current_scope={@current_scope} locale={@locale}>
  <article id="template-page" class="mx-auto max-w-8xl py-4">
    <.link
      id="back-to-templates"
      navigate={Locales.path(@locale)}
      class="inline-flex min-h-9 items-center gap-x-1 rounded-field pr-2 text-sm/6 text-ink-muted hover:text-ink focus-visible:outline-2 focus-visible:outline-focus"
    >
      <.icon name="hero-arrow-left" class="size-4" /> {gettext("Templates")}
    </.link>
    <h1 class="font-display text-2xl font-bold tracking-tight text-ink">{@schema["title"]}</h1>
    <p class="mt-1 text-sm/6 text-ink-muted">{@schema["description"]}</p>

    <div
      id="bill-app"
      phx-hook="BillApp"
      phx-update="ignore"
      data-slug={@schema["slug"]}
      data-template={@template}
      data-locale={@locale.code}
      data-fonts={Jason.encode!(@fonts)}
      data-i18n={Jason.encode!(ui_strings())}
      data-region={Jason.encode!(@region)}
      data-own-currency={Regions.default_currency(@region["country"])}
      data-edit={to_string(@document != nil)}
      data-text={Jason.encode!(@text)}
      data-businesses={Jason.encode!(@businesses)}
      data-business-id={@document && @document.business_id}
      data-signed-in={to_string(@signed_in?)}
      data-signatures={Jason.encode!(@signatures)}
      data-signature-id={@document && @document.signature_id}
      data-schema={Jason.encode!(@schema)}
      data-sample={Jason.encode!(@sample)}
      data-worker={~p"/assets/js/preview_worker.js"}
      data-turnstile-site-key={turnstile_site_key(@current_scope)}
      class="mt-4 grid gap-5 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]"
    >
      <div class="space-y-5 rounded-card border border-line bg-surface p-4">
        <%!-- Always there, even when a bill has one template: the place where more will show up. --%>
        <section data-group="template">
          <div class="mb-3 flex items-center gap-3">
            <label
              for="template-select"
              class="border-l-2 border-accent pl-2 text-xs font-semibold tracking-wider text-ink uppercase"
            >
              {gettext("Template")}
            </label>
            <span class="h-px flex-1 bg-line"></span>
          </div>
          <select
            id="template-select"
            class="block w-full rounded-field border border-line-strong bg-surface px-2.5 py-1.5 text-sm text-ink focus:border-focus focus:outline-2 focus:-outline-offset-1 focus:outline-focus sm:max-w-xs"
          >
            <option
              :for={design <- @schema["templates"]}
              value={design["id"]}
              selected={design["id"] == @template}
            >
              {design["name"]}
            </option>
          </select>
        </section>
        <%!-- The signature: one of the saved ones, or none. Only for a logged-in user, and only while the chosen design has a place to sign. --%>
        <section
          :if={@signed_in?}
          id="signature-section"
          data-group="signature"
          class={[!signature_design?(@schema, @template) && "hidden"]}
        >
          <div class="mb-3 flex items-center gap-3">
            <label
              for="signature-select"
              class="border-l-2 border-accent pl-2 text-xs font-semibold tracking-wider text-ink uppercase"
            >
              {gettext("Signature")}
            </label>
            <span class="h-px flex-1 bg-line"></span>
          </div>
          <select
            id="signature-select"
            class="block w-full rounded-field border border-line-strong bg-surface px-2.5 py-1.5 text-sm text-ink focus:border-focus focus:outline-2 focus:-outline-offset-1 focus:outline-focus sm:max-w-xs"
          >
            <option value="">{gettext("No signature (placeholder only)")}</option>
            <option
              :for={signature <- @signatures}
              value={signature.id}
              selected={@document && @document.signature_id == signature.id}
            >
              {signature.name}
            </option>
          </select>
          <details id="signature-new" class="mt-3 sm:max-w-xs">
            <summary class="cursor-pointer text-sm/6 font-medium text-primary hover:underline">
              {gettext("Save a new signature")}
            </summary>
            <div class="mt-2 space-y-2">
              <input
                id="signature-name"
                type="text"
                maxlength={QuickSlips.Signatures.Signature.max_name_length()}
                autocomplete="off"
                placeholder={gettext("Name, like Owner")}
                aria-label={gettext("Name, like Owner")}
                class="block w-full rounded-field border border-line-strong bg-surface px-2.5 py-1.5 text-sm text-ink placeholder:text-ink-faint focus:border-focus focus:outline-2 focus:-outline-offset-1 focus:outline-focus"
              />
              <input
                id="signature-file"
                type="file"
                accept="image/png,image/jpeg"
                aria-label={gettext("PNG or JPG picture, up to 1 MB")}
                class="block w-full text-sm text-ink-muted file:mr-3 file:rounded-button file:border file:border-line-strong file:bg-surface file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-ink hover:file:bg-surface-muted"
              />
              <p class="text-xs/5 text-ink-muted">{gettext("PNG or JPG picture, up to 1 MB")}</p>
              <.button id="signature-save" type="button">{gettext("Save signature")}</.button>
              <p id="signature-message" role="status" class="text-sm/6"></p>
            </div>
          </details>
        </section>
        <form id="bill-form" class="space-y-5" novalidate></form>
      </div>

      <%!-- On a wide screen the preview stays in view while the long form scrolls past it. --%>
      <div class="lg:sticky lg:top-4 lg:max-h-[calc(100vh-2rem)] lg:self-start lg:overflow-y-auto">
        <div
          id="bill-preview"
          class="flex min-h-96 items-center justify-center rounded-card border border-line bg-tray p-2"
        >
          <p class="text-sm text-ink-muted">{gettext("Preview loads here…")}</p>
        </div>
        <p id="bill-status" class="mt-2 text-sm text-ink-muted" role="status"></p>
        <p id="quota-badge" class="mt-4 text-sm text-ink-muted" role="status"></p>
        <.alert id="login-prompt" kind={:warning} class="mt-2 hidden">
          <p>
            {gettext(
              "You've used your free downloads for today. Log in or sign up to keep going, and come back tomorrow for more."
            )}
          </p>
          <p class="mt-2 flex gap-x-4">
            <.link navigate={~p"/users/log-in"} class="font-medium underline">{gettext("Log in")}</.link>
            <.link navigate={~p"/users/register"} class="font-medium underline">
              {gettext("Sign up")}
            </.link>
          </p>
        </.alert>
        <div id="turnstile-box" class="mt-4"></div>
        <.button id="download-button" type="button" block class="mt-4">
          {gettext("Download PDF")}
        </.button>
      </div>
    </div>
  </article>
</Layouts.app>

<Layouts.app flash={@flash} current_scope={@current_scope} locale={@locale}>
  <article id="template-page" class="mx-auto max-w-8xl py-4">
    <.link
      id="back-to-templates"
      navigate={Locales.path(@locale)}
      class="inline-flex min-h-9 items-center gap-x-1 rounded-field pr-2 text-sm/6 text-ink-muted hover:text-ink focus-visible:outline-2 focus-visible:outline-focus"
    >
      <.icon name="hero-arrow-left" class="size-4" /> {gettext("Templates")}
    </.link>
    <h1 class="font-display text-2xl font-bold tracking-tight text-ink">{@schema["title"]}</h1>
    <p class="mt-1 text-sm/6 text-ink-muted">{@schema["description"]}</p>

    <div
      id="bill-app"
      phx-hook="BillApp"
      phx-update="ignore"
      data-slug={@schema["slug"]}
      data-template={@template}
      data-locale={@locale.code}
      data-fonts={Jason.encode!(@fonts)}
      data-i18n={Jason.encode!(ui_strings())}
      data-region={Jason.encode!(@region)}
      data-own-currency={Regions.default_currency(@region["country"])}
      data-edit={to_string(@document != nil)}
      data-text={Jason.encode!(@text)}
      data-businesses={Jason.encode!(@businesses)}
      data-saved-entries={Jason.encode!(@saved_entries)}
      data-business-id={@document && @document.business_id}
      data-signed-in={to_string(@signed_in?)}
      data-signatures={Jason.encode!(@signatures)}
      data-signature-id={@document && @document.signature_id}
      data-driver-signature-id={@document && @document.driver_signature_id}
      data-stamps={Jason.encode!(@system_stamps ++ @stamps)}
      data-stamp-choice={@stamp_choice}
      data-paper={@paper}
      data-margin={@margin}
      data-schema={Jason.encode!(Map.drop(@schema, ["intro", "faq"]))}
      data-sample={Jason.encode!(@sample)}
      data-worker={~p"/assets/js/preview_worker.js"}
      data-turnstile-site-key={turnstile_site_key(@current_scope)}
      class="mt-4 grid gap-5 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]"
    >
      <div class="space-y-5 rounded-card border border-line bg-surface p-4">
        <%!-- Always there, even when a bill has one template: the place where more will show up. --%>
        <section data-group="template">
          <div class="mb-3 flex items-center gap-3">
            <label
              id="design-picker-label"
              class="border-l-2 border-accent pl-2 text-xs font-semibold tracking-wider text-ink uppercase"
            >
              {gettext("Template")}
            </label>
            <span class="h-px flex-1 bg-line"></span>
          </div>
          <%!-- The designs of the bill, each with a small picture of the sample drawn by `ThumbnailController`. --%>
          <div
            id="design-picker"
            role="radiogroup"
            aria-labelledby="design-picker-label"
            class="grid grid-cols-3 gap-2 sm:grid-cols-6"
          >
            <label
              :for={design <- @schema["templates"]}
              class="group relative flex cursor-pointer flex-col gap-1.5 rounded-card border border-line bg-surface p-1.5 transition-colors motion-reduce:transition-none hover:border-line-strong has-checked:border-primary has-checked:bg-primary-soft has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-focus"
            >
              <input
                type="radio"
                name="design"
                value={design["id"]}
                checked={design["id"] == @template}
                class="sr-only"
              />
              <span class="flex aspect-3/4 items-start justify-center overflow-hidden rounded-field bg-paper">
                <img
                  src={~p"/thumbnails/#{@schema["slug"]}/#{design["id"]}"}
                  alt=""
                  loading="lazy"
                  width="150"
                  height="200"
                  class="max-h-full max-w-full object-contain"
                />
              </span>
              <span class="truncate text-center text-xs/5 font-medium text-ink">{design["name"]}</span>
            </label>
          </div>
        </section>
        <form id="bill-form" class="space-y-5" novalidate></form>
        <%!-- What can be saved and chosen again: below the form, above the advanced settings. --%>
        <%!-- The signature: one of the saved ones, or none. Only for a logged-in user, and only while the chosen design has a place to sign. --%>
        <section
          :if={@signed_in?}
          id="signature-section"
          data-group="signature"
          class={[!signature_design?(@schema, @template) && "hidden"]}
        >
          <div class="mb-3 flex items-center gap-3">
            <label
              for="signature-select"
              class="border-l-2 border-accent pl-2 text-xs font-semibold tracking-wider text-ink uppercase"
            >
              {signature_heading(@schema, @text)}
            </label>
            <span class="h-px flex-1 bg-line"></span>
          </div>
          <div class="flex items-center gap-2 sm:max-w-sm">
            <select
              id="signature-select"
              class="block w-full min-w-0 flex-1 rounded-field border border-line-strong bg-surface px-2.5 py-1.5 text-sm text-ink focus:border-focus focus:outline-2 focus:-outline-offset-1 focus:outline-focus"
            >
              <option value="">{gettext("No signature (placeholder only)")}</option>
              <option
                :for={signature <- @signatures}
                value={signature.id}
                selected={@document && @document.signature_id == signature.id}
              >
                {signature.name}
              </option>
            </select>
            <button
              type="button"
              id="signature-open"
              data-dialog-open="signature-dialog"
              aria-haspopup="dialog"
              title={gettext("Save a new signature")}
              class="inline-flex size-9 shrink-0 items-center justify-center rounded-field border border-line-strong bg-surface text-ink transition-colors hover:bg-surface-muted focus-visible:outline-2 focus-visible:outline-focus motion-reduce:transition-none"
            >
              <.icon name="hero-plus" class="size-5" />
              <span class="sr-only">{gettext("Save a new signature")}</span>
            </button>
          </div>
          <p id="signature-note" role="status" class="mt-1 text-sm/6 text-ink-muted"></p>
          <%!-- The upload happens in a dialog: the picture, its name and the confirmation of the rights. --%>
          <dialog
            id="signature-dialog"
            aria-labelledby="signature-dialog-title"
            data-backdrop-close
            class="m-auto w-[calc(100%-2rem)] max-w-md rounded-card border border-line bg-surface p-0 text-ink shadow-pop backdrop:bg-overlay"
          >
            <div class="space-y-3 p-5">
              <div class="flex items-center justify-between gap-3">
                <h2 id="signature-dialog-title" class="text-base/6 font-semibold">
                  {gettext("Save a new signature")}
                </h2>
                <button
                  type="button"
                  data-dialog-close
                  class="-mr-2 inline-flex size-9 items-center justify-center rounded-full text-ink-muted hover:bg-surface-muted hover:text-ink focus-visible:outline-2 focus-visible:outline-focus"
                >
                  <span class="sr-only">{gettext("close")}</span>
                  <.icon name="hero-x-mark" class="size-5" />
                </button>
              </div>
              <div class="space-y-2">
                <input
                  id="signature-name"
                  type="text"
                  maxlength={QuickSlips.Signatures.Signature.max_name_length()}
                  autocomplete="off"
                  placeholder={gettext("Name, like Owner")}
                  aria-label={gettext("Name, like Owner")}
                  class="block w-full rounded-field border border-line-strong bg-surface px-2.5 py-1.5 text-sm text-ink placeholder:text-ink-faint focus:border-focus focus:outline-2 focus:-outline-offset-1 focus:outline-focus"
                />
                <input
                  id="signature-file"
                  type="file"
                  accept="image/png,image/jpeg"
                  aria-label={gettext("PNG or JPG picture, up to 1 MB")}
                  class="block w-full text-sm text-ink-muted file:mr-3 file:rounded-button file:border file:border-line-strong file:bg-surface file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-ink hover:file:bg-surface-muted"
                />
                <p class="text-xs/5 text-ink-muted">
                  {gettext("PNG or JPG picture, up to 1 MB")}
                </p>
                <label for="signature-rights" class="flex items-start gap-2 text-xs/5 text-ink">
                  <input
                    id="signature-rights"
                    type="checkbox"
                    class="mt-0.5 size-4 rounded border-line-strong text-primary focus:outline-2 focus:outline-focus"
                  />
                  <span>{gettext("I confirm I have the rights to use this image")}</span>
                </label>
                <.button id="signature-save" type="button">{gettext("Save signature")}</.button>
                <p id="signature-message" role="status" class="text-sm/6"></p>
              </div>
            </div>
          </dialog>
        </section>
        <%!-- The driver's signature, for a design that has a place for it: one of the saved signatures, or none. --%>
        <section
          :if={@signed_in?}
          id="driver-signature-section"
          data-group="driver-signature"
          class={[!driver_signature_design?(@schema, @template) && "hidden"]}
        >
          <div class="mb-3 flex items-center gap-3">
            <label
              for="driver-signature-select"
              class="border-l-2 border-accent pl-2 text-xs font-semibold tracking-wider text-ink uppercase"
            >
              {driver_signature_heading(@text)}
            </label>
            <span class="h-px flex-1 bg-line"></span>
          </div>
          <div class="flex items-center gap-2 sm:max-w-sm">
            <select
              id="driver-signature-select"
              class="block w-full min-w-0 flex-1 rounded-field border border-line-strong bg-surface px-2.5 py-1.5 text-sm text-ink focus:border-focus focus:outline-2 focus:-outline-offset-1 focus:outline-focus"
            >
              <option value="">{gettext("No signature (placeholder only)")}</option>
              <option
                :for={signature <- @signatures}
                value={signature.id}
                selected={@document && @document.driver_signature_id == signature.id}
              >
                {signature.name}
              </option>
            </select>
            <button
              type="button"
              id="driver-signature-open"
              data-dialog-open="signature-dialog"
              aria-haspopup="dialog"
              title={gettext("Save a new signature")}
              class="inline-flex size-9 shrink-0 items-center justify-center rounded-field border border-line-strong bg-surface text-ink transition-colors hover:bg-surface-muted focus-visible:outline-2 focus-visible:outline-focus motion-reduce:transition-none"
            >
              <.icon name="hero-plus" class="size-5" />
              <span class="sr-only">{gettext("Save a new signature")}</span>
            </button>
          </div>
        </section>
        <%!-- The revenue stamp: the empty box, the default stamp of the site, or one of the saved ones. Only while the chosen design has a place for it and the document is for India. --%>
        <section
          id="stamp-section"
          data-group="stamp"
          class={[!stamp_design?(@schema, @template, @region) && "hidden"]}
        >
          <div class="mb-3 flex items-center gap-3">
            <label
              for="stamp-select"
              class="border-l-2 border-accent pl-2 text-xs font-semibold tracking-wider text-ink uppercase"
            >
              {gettext("Revenue stamp")}
            </label>
            <span class="h-px flex-1 bg-line"></span>
          </div>
          <div class="flex items-center gap-2 sm:max-w-sm">
            <select
              id="stamp-select"
              class="block w-full min-w-0 flex-1 rounded-field border border-line-strong bg-surface px-2.5 py-1.5 text-sm text-ink focus:border-focus focus:outline-2 focus:-outline-offset-1 focus:outline-focus"
            >
              <option value="" selected={@stamp_choice == ""}>
                {gettext("Empty box (placeholder only)")}
              </option>
              <option
                :for={stamp <- @system_stamps}
                value={stamp.id}
                selected={@stamp_choice == stamp.id}
              >
                {stamp.name}
              </option>
              <option
                :for={stamp <- @stamps}
                value={stamp.id}
                selected={@stamp_choice == to_string(stamp.id)}
              >
                {stamp.name}
              </option>
            </select>
            <button
              :if={@signed_in?}
              type="button"
              id="stamp-open"
              data-dialog-open="stamp-dialog"
              aria-haspopup="dialog"
              title={gettext("Save a new stamp")}
              class="inline-flex size-9 shrink-0 items-center justify-center rounded-field border border-line-strong bg-surface text-ink transition-colors hover:bg-surface-muted focus-visible:outline-2 focus-visible:outline-focus motion-reduce:transition-none"
            >
              <.icon name="hero-plus" class="size-5" />
              <span class="sr-only">{gettext("Save a new stamp")}</span>
            </button>
          </div>
          <p :if={@signed_in?} id="stamp-note" role="status" class="mt-1 text-sm/6 text-ink-muted">
          </p>
          <%!-- The upload happens in a dialog: the picture, its name and the confirmation of the rights. --%>
          <dialog
            :if={@signed_in?}
            id="stamp-dialog"
            aria-labelledby="stamp-dialog-title"
            data-backdrop-close
            class="m-auto w-[calc(100%-2rem)] max-w-md rounded-card border border-line bg-surface p-0 text-ink shadow-pop backdrop:bg-overlay"
          >
            <div class="space-y-3 p-5">
              <div class="flex items-center justify-between gap-3">
                <h2 id="stamp-dialog-title" class="text-base/6 font-semibold">
                  {gettext("Save a new stamp")}
                </h2>
                <button
                  type="button"
                  data-dialog-close
                  class="-mr-2 inline-flex size-9 items-center justify-center rounded-full text-ink-muted hover:bg-surface-muted hover:text-ink focus-visible:outline-2 focus-visible:outline-focus"
                >
                  <span class="sr-only">{gettext("close")}</span>
                  <.icon name="hero-x-mark" class="size-5" />
                </button>
              </div>
              <div class="space-y-2">
                <input
                  id="stamp-name"
                  type="text"
                  maxlength={QuickSlips.Stamps.Stamp.max_name_length()}
                  autocomplete="off"
                  placeholder={gettext("Name, like Rent receipts")}
                  aria-label={gettext("Name, like Rent receipts")}
                  class="block w-full rounded-field border border-line-strong bg-surface px-2.5 py-1.5 text-sm text-ink focus:border-focus focus:outline-2 focus:-outline-offset-1 focus:outline-focus"
                />
                <input
                  id="stamp-file"
                  type="file"
                  accept="image/png,image/jpeg"
                  aria-label={gettext("PNG or JPG picture, up to 1 MB")}
                  class="block w-full text-sm text-ink-muted file:mr-3 file:rounded-field file:border-0 file:bg-surface-muted file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-ink"
                />
                <p class="text-xs/5 text-ink-muted">
                  {gettext("PNG or JPG picture, up to 1 MB")}
                </p>
                <label for="stamp-rights" class="flex items-start gap-2 text-xs/5 text-ink">
                  <input
                    id="stamp-rights"
                    type="checkbox"
                    class="mt-0.5 size-4 rounded border-line-strong text-primary focus:outline-2 focus:outline-focus"
                  />
                  <span>{gettext("I confirm I have the rights to use this image")}</span>
                </label>
                <.button id="stamp-save" type="button">{gettext("Save stamp")}</.button>
                <p id="stamp-message" role="status" class="text-sm/6"></p>
              </div>
            </div>
          </dialog>
        </section>
        <%!-- The settings that most people leave as they are: the paper and the margins. --%>
        <details
          id="advanced-settings"
          class="rounded-card border border-line bg-surface-muted/40 open:bg-transparent"
        >
          <summary class="cursor-pointer rounded-card px-3 py-2.5 text-sm/6 font-semibold text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">
            {gettext("Advanced settings")}
          </summary>
          <div class="space-y-5 px-3 pt-2 pb-4">
            <%!-- The paper: any sheet for a design that is not made for a thermal roll; a roll keeps its own width. --%>
            <section id="paper-section" data-group="paper">
              <div class="mb-3 flex items-center gap-3">
                <label
                  for="paper-select"
                  class="border-l-2 border-accent pl-2 text-xs font-semibold tracking-wider text-ink uppercase"
                >
                  {gettext("Paper")}
                </label>
                <span class="h-px flex-1 bg-line"></span>
              </div>
              <select
                id="paper-select"
                class={[
                  "block w-full rounded-field border border-line-strong bg-surface px-2.5 py-1.5 text-sm text-ink focus:border-focus focus:outline-2 focus:-outline-offset-1 focus:outline-focus sm:max-w-xs",
                  !paper_choice?(@schema, @template) && "hidden"
                ]}
              >
                <option value="" selected={@paper == ""}>{gettext("As designed")}</option>
                <option value="a4" selected={@paper == "a4"}>A4</option>
                <option value="a5" selected={@paper == "a5"}>A5</option>
                <option value="us-letter" selected={@paper == "us-letter"}>US Letter</option>
              </select>
              <p
                id="paper-thermal"
                class={["text-sm/6 text-ink-muted", paper_choice?(@schema, @template) && "hidden"]}
              >
                {gettext("Made for a thermal receipt printer, so there is no paper to choose.")}
              </p>
            </section>
            <section id="margin-section" data-group="margin">
              <div class="mb-3 flex items-center gap-3">
                <label
                  for="margin-select"
                  class="border-l-2 border-accent pl-2 text-xs font-semibold tracking-wider text-ink uppercase"
                >
                  {gettext("Margins")}
                </label>
                <span class="h-px flex-1 bg-line"></span>
              </div>
              <select
                id="margin-select"
                class={[
                  "block w-full rounded-field border border-line-strong bg-surface px-2.5 py-1.5 text-sm text-ink focus:border-focus focus:outline-2 focus:-outline-offset-1 focus:outline-focus sm:max-w-xs",
                  !paper_choice?(@schema, @template) && "hidden"
                ]}
              >
                <option value="" selected={@margin == ""}>{gettext("As designed")}</option>
                <option value="narrow" selected={@margin == "narrow"}>{gettext("Narrow")}</option>
                <option value="wide" selected={@margin == "wide"}>{gettext("Wide")}</option>
              </select>
            </section>
          </div>
        </details>
      </div>

      <%!-- On a wide screen the preview stays in view while the long form scrolls past it. --%>
      <div class="lg:sticky lg:top-4 lg:max-h-[calc(100vh-2rem)] lg:self-start lg:overflow-y-auto">
        <div
          id="bill-preview"
          class="flex min-h-96 items-center justify-center rounded-card border border-line bg-tray p-2"
        >
          <p class="text-sm text-ink-muted">{gettext("Preview loads here…")}</p>
        </div>
        <p id="bill-status" class="mt-2 text-sm text-ink-muted" role="status"></p>
        <p id="quota-badge" class="mt-4 text-sm text-ink-muted" role="status"></p>
        <.alert id="login-prompt" kind={:warning} class="mt-2 hidden">
          <p>
            {gettext(
              "You've used your free downloads for today. Log in or sign up to keep going, and come back tomorrow for more."
            )}
          </p>
          <p class="mt-2 flex gap-x-4">
            <.link navigate={~p"/users/log-in"} class="font-medium underline">{gettext("Log in")}</.link>
            <.link navigate={~p"/users/register"} class="font-medium underline">
              {gettext("Sign up")}
            </.link>
          </p>
        </.alert>
        <div id="turnstile-box" class="mt-4"></div>
        <.button id="download-button" type="button" block class="mt-4">
          {gettext("Download PDF")}
        </.button>
      </div>
    </div>

    <%!-- What the bill is, and what people ask about it: words for the reader, and for a search engine. --%>
    <section
      :if={@schema["intro"] || @schema["faq"] != []}
      id="bill-about"
      class="mt-10 max-w-3xl border-t border-line pt-8"
    >
      <div :if={@schema["intro"]} id="bill-intro">
        <h2 class="font-display text-xl font-semibold tracking-tight text-ink">
          {@schema["name"]}
        </h2>
        <p class="mt-2 text-base/7 text-ink">{@schema["intro"]}</p>
      </div>

      <div :if={@schema["faq"] != []} id="bill-faq" class="mt-8">
        <h2 class="font-display text-xl font-semibold tracking-tight text-ink">
          {gettext("Frequently asked questions")}
        </h2>
        <div class="mt-4 divide-y divide-line border-y border-line">
          <div :for={item <- @schema["faq"]} class="py-4">
            <h3 class="text-base/6 font-semibold text-ink">{item["q"]}</h3>
            <p class="mt-1.5 text-sm/6 text-ink-muted">{item["a"]}</p>
          </div>
        </div>
      </div>
    </section>

    <%!-- Missing a field, a country or a language? The people who use a template know best. --%>
    <aside
      :if={@feedback_path}
      id="bill-feedback"
      class="mt-10 max-w-3xl rounded-card border border-line bg-surface-muted p-5 sm:flex sm:items-center sm:justify-between sm:gap-x-6"
    >
      <div>
        <h2 class="text-base/6 font-semibold text-ink">
          {gettext("Is something missing or wrong in this template?")}
        </h2>
        <p class="mt-1 text-sm/6 text-ink-muted">
          {gettext(
            "Tell us what you would like changed or added, or report a mistake. We read every message."
          )}
        </p>
      </div>
      <.button
        id="bill-feedback-link"
        variant="secondary"
        navigate={@feedback_path}
        class="mt-4 shrink-0 sm:mt-0"
      >
        {gettext("Tell us")}
      </.button>
    </aside>
  </article>
</Layouts.app>

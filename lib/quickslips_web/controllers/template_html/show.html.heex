<Layouts.app flash={@flash} current_scope={@current_scope}>
  <article id="template-page" class="mx-auto max-w-5xl py-10">
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink">{@schema["title"]}</h1>
    <p class="mt-2 text-ink-muted">{@schema["description"]}</p>

    <div
      id="bill-app"
      data-slug={@schema["slug"]}
      data-template="t1"
      data-schema={Jason.encode!(@schema)}
      data-sample={Jason.encode!(@sample)}
      data-worker={~p"/assets/js/preview_worker.js"}
      class="mt-8 grid gap-8 lg:grid-cols-2"
    >
      <form id="bill-form" class="space-y-4" novalidate>
      </form>

      <div>
        <div
          id="bill-preview"
          class="flex min-h-96 items-center justify-center rounded-card border border-line bg-tray p-2"
        >
          <p class="text-sm text-ink-muted">Preview loads here…</p>
        </div>
        <p id="bill-status" class="mt-2 text-sm text-ink-muted" role="status"></p>
        <p id="quota-badge" class="mt-4 text-sm text-ink-muted" role="status"></p>
        <.alert id="login-prompt" kind={:warning} class="mt-2 hidden">
          You've used your free downloads for today.
          <.link href={~p"/users/log-in"} class="font-medium underline">Log in</.link>
          or <.link href={~p"/users/register"} class="font-medium underline">sign up</.link>
          to keep going, and come back tomorrow for more.
        </.alert>
        <.button id="download-button" type="button" block class="mt-4">
          Download PDF
        </.button>
      </div>
    </div>
  </article>
</Layouts.app>

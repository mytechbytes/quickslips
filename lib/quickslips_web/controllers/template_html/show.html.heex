<Layouts.app flash={@flash} current_scope={@current_scope}>
  <article id="template-page" class="mx-auto max-w-2xl py-10">
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink">{@schema["title"]}</h1>
    <p class="mt-2 text-ink-muted">{@schema["description"]}</p>

    <h2 class="mt-8 text-lg font-semibold text-ink">Fields in this template</h2>
    <ul
      id="field-list"
      class="mt-3 divide-y divide-line rounded-card border border-line bg-surface shadow-card"
    >
      <li :for={field <- @schema["fields"]} class="flex justify-between px-4 py-2 text-sm">
        <span class="text-ink">{field["label"]}</span>
        <span class="text-ink-faint">{field["type"]}</span>
      </li>
    </ul>

    <.alert kind={:info} class="mt-8">
      The live form and preview arrive in Milestone 6.
    </.alert>
  </article>
</Layouts.app>

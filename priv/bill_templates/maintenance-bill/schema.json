{
  "slug": "maintenance-bill",
  "public_slug": "maintenance-bill-generator",
  "title": "Maintenance Bill Generator",
  "category": "Travel",
  "icon": "hero-cog-6-tooth",
  "number_field": "document_number",
  "summary": "Workshop estimate or invoice with parts, labour and {tax}.",
  "description": "Generate a car or bike workshop estimate, invoice or job card with the customer and vehicle, spare parts with discounts, labour jobs and {tax}. Preview instantly and download as PDF.",
  "languages": ["en", "hi", "es", "de", "fr", "it", "pt", "zh", "ja"],
  "tax": { "default": "added" },
  "templates": [{ "id": "t1" }],
  "saved_groups": ["customer", "details"],
  "fields": [
    { "key": "workshop_name", "group": "business", "label": "Workshop Name", "type": "text", "required": true, "max_length": 80, "prefill": "business.name" },
    { "key": "workshop_address", "group": "business", "label": "Workshop Address", "type": "textarea", "required": true, "max_length": 200, "prefill": "business.address" },
    { "key": "workshop_phone", "group": "business", "label": "Contact (optional)", "type": "text", "required": false, "max_length": 20 },
    { "key": "dealer_name", "group": "business", "label": "Authorised Dealer (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "seller_tax_id", "group": "registration", "label": "Registration Number (optional)", "type": "tax_id", "required": false, "max_length": 20 },
    { "key": "document_type", "group": "document", "label": "Document", "type": "select", "options": ["Estimate", "Invoice", "Job card"], "required": true },
    { "key": "document_number", "group": "document", "label": "Document Number", "type": "text", "required": true, "max_length": 30 },
    { "key": "reference_number", "group": "document", "label": "Reference Number (optional)", "type": "text", "required": false, "max_length": 30 },
    { "key": "date", "group": "document", "label": "Date", "type": "date", "required": true },
    { "key": "workshop_section", "group": "document", "label": "Workshop Section (optional)", "type": "select", "options": ["Main workshop", "Service bay", "Body shop", "Spare counter", "Express lane", "PDI bay"], "required": false },
    { "key": "customer_name", "group": "customer", "label": "Customer Name", "type": "text", "required": true, "max_length": 80 },
    { "key": "customer_phone", "group": "customer", "label": "Contact (optional)", "type": "text", "required": false, "max_length": 20 },
    { "key": "vehicle_model", "group": "details", "label": "Model", "type": "text", "required": true, "max_length": 60 },
    { "key": "registration_number", "group": "details", "label": "Registration Number", "type": "text", "required": true, "max_length": 20 },
    { "key": "vin", "group": "details", "label": "VIN (optional)", "type": "text", "required": false, "max_length": 30 },
    { "key": "insurance_company", "group": "details", "label": "Insurance Company (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "parts", "group": "items", "label": "Parts", "type": "items", "required": false, "max_rows": 30, "name_max_length": 80, "code_max_length": 30,
      "cells": ["code", "name", "billing", "qty", "rate", "discount"],
      "billing_options": ["PAID", "Warranty", "Insurance"],
      "columns": { "code": "Part no.", "name": "Description", "billing": "Billing", "qty": "Qty", "rate": "Rate ({currency})", "discount": "Disc. %" } },
    { "key": "labour", "group": "items", "label": "Labour", "type": "items", "required": false, "max_rows": 30, "name_max_length": 80, "code_max_length": 30,
      "cells": ["code", "name", "billing", "rate", "discount"],
      "billing_options": ["PAID", "Warranty", "Insurance"],
      "columns": { "code": "Job code", "name": "Job", "billing": "Billing", "rate": "Amount ({currency})", "discount": "Disc. %" } },
    { "key": "tax_percent", "group": "charges", "label": "{tax} (%) (optional)", "type": "tax_rate", "required": false },
    { "key": "terms", "group": "details", "label": "Terms, One per Line (optional)", "type": "textarea", "required": false, "max_length": 600 }
  ]
}

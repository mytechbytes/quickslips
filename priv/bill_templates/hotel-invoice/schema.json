{
  "slug": "hotel-invoice",
  "public_slug": "hotel-bill-generator",
  "title": "Hotel Bill Generator",
  "category": "Travel",
  "icon": "hero-building-office-2",
  "number_field": "invoice_number",
  "summary": "Room stay bill with tariff, extras and {tax}.",
  "description": "Create a hotel bill with guest, room, check-in and check-out, tariff per night, extra charges and {tax}. Preview instantly and download as PDF.",
  "tax": { "default": "added" },
  "templates": [{ "id": "t1", "name": "Classic" }],
  "fields": [
    { "key": "hotel_name", "group": "business", "label": "Hotel name", "type": "text", "required": true, "max_length": 80, "prefill": "business.name" },
    { "key": "hotel_address", "group": "business", "label": "Address (optional)", "type": "textarea", "required": false, "max_length": 200, "prefill": "business.address" },
    { "key": "gstin", "group": "registration", "label": "{tax_id} (optional)", "type": "text", "required": false, "max_length": 20, "prefill": "business.gstin" },
    { "key": "invoice_number", "group": "document", "label": "Invoice number", "type": "text", "required": true, "max_length": 30 },
    { "key": "invoice_date", "group": "document", "label": "Invoice date", "type": "date", "required": true },
    { "key": "guest_name", "group": "customer", "label": "Guest name", "type": "text", "required": true, "max_length": 80 },
    { "key": "guest_address", "group": "customer", "label": "Guest address (optional)", "type": "textarea", "required": false, "max_length": 200 },
    { "key": "room_type", "group": "details", "label": "Room type", "type": "select", "options": ["Standard", "Deluxe", "Suite", "Dormitory"], "required": true },
    { "key": "room_number", "group": "details", "label": "Room number (optional)", "type": "text", "required": false, "max_length": 10 },
    { "key": "check_in", "group": "details", "label": "Check-in", "type": "date", "required": true },
    { "key": "check_out", "group": "details", "label": "Check-out", "type": "date", "required": true },
    { "key": "tariff_per_night", "group": "charges", "label": "Tariff per night ({currency})", "type": "number", "required": true, "min": 0 },
    { "key": "extra_charges", "group": "charges", "label": "Food and other charges ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "gst_percent", "group": "charges", "label": "{tax} (%) (optional)", "type": "tax_rate", "required": false }
  ]
}

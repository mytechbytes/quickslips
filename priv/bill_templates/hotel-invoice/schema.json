{
  "slug": "hotel-invoice",
  "public_slug": "hotel-bill-generator",
  "title": "Hotel Bill Generator",
  "category": "Travel",
  "icon": "hero-building-office-2",
  "number_field": "invoice_number",
  "summary": "Room stay bill with tariff, extras, advance and {tax}.",
  "description": "Create a hotel bill with guest, room, check-in and check-out, tariff per night, extra rooms and services, advance and {tax}. Three designs; preview instantly and download as PDF.",
  "languages": ["en", "hi", "es", "de", "fr", "it", "pt", "zh", "ja"],
  "tax": { "default": "added", "es": "included", "de": "included", "fr": "included", "it": "included", "gb": "included", "jp": "included", "cn": "included" },
  "templates": [{ "id": "t1" }, { "id": "t2" }, { "id": "t3" }],
  "fields": [
    { "key": "hotel_name", "group": "business", "label": "Hotel name", "type": "text", "required": true, "max_length": 80, "prefill": "business.name" },
    { "key": "hotel_address", "group": "business", "label": "Hotel address (optional)", "type": "textarea", "required": false, "max_length": 200, "prefill": "business.address" },
    { "key": "gstin", "group": "registration", "label": "{tax_id} (optional)", "type": "text", "required": false, "max_length": 20, "prefill": "business.gstin" },
    { "key": "registration_number", "group": "registration", "label": "Registration no. / CIN (optional)", "type": "text", "required": false, "max_length": 30, "countries": ["in"] },
    { "key": "invoice_number", "group": "document", "label": "Bill number", "type": "text", "required": true, "max_length": 30 },
    { "key": "reservation_number", "group": "document", "label": "Reservation number (optional)", "type": "text", "required": false, "max_length": 30 },
    { "key": "invoice_date", "group": "document", "label": "Bill date", "type": "date", "required": true },
    { "key": "guest_name", "group": "customer", "label": "Guest name", "type": "text", "required": true, "max_length": 80 },
    { "key": "guest_gender", "group": "customer", "label": "Gender (optional)", "type": "select", "options": ["Male", "Female", "Transgender"], "required": false },
    { "key": "guest_age", "group": "customer", "label": "Age (optional)", "type": "text", "required": false, "max_length": 3, "pattern": "^[0-9]{1,3}$" },
    { "key": "nationality", "group": "customer", "label": "Nationality (optional)", "type": "text", "required": false, "max_length": 40 },
    { "key": "guest_address", "group": "customer", "label": "Guest address (optional)", "type": "textarea", "required": false, "max_length": 200 },
    { "key": "room_type", "group": "details", "label": "Room type", "type": "select", "options": ["Standard", "Deluxe", "Suite", "Dormitory"], "required": true },
    { "key": "room_description", "group": "details", "label": "Room description (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "room_number", "group": "details", "label": "Room number (optional)", "type": "text", "required": false, "max_length": 10 },
    { "key": "check_in", "group": "details", "label": "Check-in date", "type": "date", "required": true },
    { "key": "check_in_time", "group": "details", "label": "Check-in time (optional)", "type": "time", "required": false },
    { "key": "check_out", "group": "details", "label": "Check-out date", "type": "date", "required": true },
    { "key": "check_out_time", "group": "details", "label": "Check-out time (optional)", "type": "time", "required": false },
    { "key": "tariff_per_night", "group": "charges", "label": "Tariff per night ({currency})", "type": "number", "required": true, "min": 0 },
    { "key": "items", "group": "items", "label": "More rooms or services (optional)", "type": "items", "required": false, "max_rows": 20, "name_max_length": 100,
      "cells": ["name", "rate", "qty"],
      "columns": { "name": "Room type and description", "rate": "Rate ({currency})", "qty": "No. of days" } },
    { "key": "extra_charges", "group": "charges", "label": "Food and other charges ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "gst_percent", "group": "charges", "label": "{tax} (%) (optional)", "type": "tax_rate", "required": false },
    { "key": "advance_amount", "group": "charges", "label": "Advance paid ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "payment_mode", "group": "payment", "label": "Payment type", "type": "select", "options": ["Cash", "UPI", "Card", "Bank transfer", "Online"], "required": true }
  ]
}

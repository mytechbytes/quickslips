{
  "slug": "hypermarket-bill",
  "public_slug": "hypermarket-bill-generator",
  "title": "Hypermarket Bill Generator",
  "category": "Food & shopping",
  "icon": "hero-building-storefront",
  "number_field": "invoice_number",
  "summary": "Hypermarket tax invoice with a tax rate per item.",
  "description": "Create a hypermarket or supermarket tax invoice with HSN codes, a tax rate for each item, the {tax} breakup by rate, order and delivery details and your savings. Preview instantly and download as PDF.",
  "languages": ["en", "hi", "es", "de", "fr", "it", "pt", "zh", "ja"],
  "tax": { "default": "included", "us": "added", "br": "added", "ca": "added" },
  "templates": [{ "id": "t1" }],
  "fields": [
    { "key": "brand_name", "group": "business", "label": "Store brand", "type": "text", "required": true, "max_length": 60, "prefill": "business.name" },
    { "key": "company_name", "group": "business", "label": "Company name", "type": "text", "required": true, "max_length": 80 },
    { "key": "company_address", "group": "business", "label": "Company address (optional)", "type": "textarea", "required": false, "max_length": 200, "prefill": "business.address" },
    { "key": "phone", "group": "business", "label": "Customer care phone (optional)", "type": "text", "required": false, "max_length": 30 },
    { "key": "email", "group": "business", "label": "Customer care email (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "website", "group": "business", "label": "Terms web address (optional)", "type": "text", "required": false, "max_length": 100 },
    { "key": "cin", "group": "registration", "label": "CIN (optional)", "type": "text", "required": false, "max_length": 21, "countries": ["in"] },
    { "key": "seller_tax_id", "group": "registration", "label": "{tax_id} (optional)", "type": "tax_id", "required": false, "max_length": 20, "prefill": "business.gstin" },
    { "key": "fssai", "group": "registration", "label": "FSSAI no. (optional)", "type": "text", "required": false, "max_length": 14, "pattern": "^[0-9]{14}$", "countries": ["in"] },
    { "key": "invoice_number", "group": "document", "label": "Invoice number", "type": "text", "required": true, "max_length": 30 },
    { "key": "date", "group": "document", "label": "Invoice date", "type": "date", "required": true },
    { "key": "order_number", "group": "details", "label": "Order number (optional)", "type": "text", "required": false, "max_length": 30 },
    { "key": "order_date", "group": "details", "label": "Order date (optional)", "type": "date", "required": false },
    { "key": "delivery_date", "group": "details", "label": "Delivery date (optional)", "type": "date", "required": false },
    { "key": "delivery_time", "group": "details", "label": "Delivery time (optional)", "type": "text", "required": false, "max_length": 30 },
    { "key": "payment_mode", "group": "details", "label": "Payment mode", "type": "select", "options": ["Cash", "UPI", "Card", "Bank transfer", "Online"], "required": true },
    { "key": "customer_name", "group": "customer", "label": "Customer name (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "customer_phone", "group": "customer", "label": "Mobile number (optional)", "type": "text", "required": false, "max_length": 20 },
    { "key": "delivery_mode", "group": "customer", "label": "Delivery mode", "type": "select", "options": ["Self pick-up", "Home delivery"], "required": true },
    { "key": "delivery_address", "group": "customer", "label": "Pick-up / delivery address (optional)", "type": "textarea", "required": false, "max_length": 200 },
    { "key": "items", "group": "items", "label": "Items", "type": "items", "required": true, "max_rows": 40, "name_max_length": 80, "cell_max_length": 12,
      "cells": ["name", "hsn", "qty", "rate", "tax"],
      "columns": { "name": "Item", "hsn": "HSN code", "qty": "Qty", "rate": "Price ({currency})", "tax": "Tax %" } },
    { "key": "savings", "group": "charges", "label": "Savings on the list price ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "payment_note", "group": "payment", "label": "Payment instruction (optional)", "type": "text", "required": false, "max_length": 60 }
  ]
}

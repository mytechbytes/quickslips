{
  "slug": "service-invoice",
  "public_slug": "invoice-generator",
  "title": "Invoice Generator",
  "category": "Work",
  "icon": "hero-wrench-screwdriver",
  "number_field": "invoice_number",
  "summary": "Charges for work or a service, with GST.",
  "description": "Generate an invoice for a service with client details, any number of service lines, GST and payment notes. Preview instantly and download as PDF.",
  "templates": [{ "id": "t1", "name": "Classic" }],
  "fields": [
    { "key": "seller_name", "label": "Your business name", "type": "text", "required": true, "max_length": 80, "prefill": "business.name" },
    { "key": "seller_address", "label": "Your address (optional)", "type": "textarea", "required": false, "max_length": 200, "prefill": "business.address" },
    { "key": "gstin", "label": "GSTIN (optional)", "type": "text", "required": false, "max_length": 15, "prefill": "business.gstin" },
    { "key": "invoice_number", "label": "Invoice number", "type": "text", "required": true, "max_length": 30 },
    { "key": "invoice_date", "label": "Invoice date", "type": "date", "required": true },
    { "key": "due_date", "label": "Due date (optional)", "type": "date", "required": false },
    { "key": "client_name", "label": "Client name", "type": "text", "required": true, "max_length": 80 },
    { "key": "client_address", "label": "Client address (optional)", "type": "textarea", "required": false, "max_length": 200 },
    { "key": "client_gstin", "label": "Client GSTIN (optional)", "type": "text", "required": false, "max_length": 15 },
    { "key": "items", "label": "Items", "type": "items", "required": true, "max_rows": 30, "name_max_length": 120,
      "columns": { "name": "Description", "qty": "Qty", "rate": "Rate ({currency})" },
      "legacy": { "name": "service", "qty": "qty", "rate": "rate", "count": 3 } },
    { "key": "gst_percent", "label": "{tax} (%) (optional)", "type": "tax_rate", "required": false },
    { "key": "notes", "label": "Payment details or notes (optional)", "type": "textarea", "required": false, "max_length": 300 }
  ]
}

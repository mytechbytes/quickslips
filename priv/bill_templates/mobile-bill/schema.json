{
  "slug": "mobile-bill",
  "public_slug": "mobile-bill-generator",
  "title": "Mobile Bill Generator",
  "category": "Home & utilities",
  "icon": "hero-device-phone-mobile",
  "number_field": "bill_number",
  "summary": "Prepaid recharge or postpaid plan bill.",
  "description": "Generate a mobile bill or recharge receipt with number, plan, validity, charges and {tax}. Preview instantly and download as PDF.",
  "intro": "A mobile bill shows what a phone connection cost for a period. It lists the number, the plan, the validity, the charges and the tax.",
  "tax": { "default": "added" },
  "templates": [{ "id": "t1", "name": "Classic" }],
  "saved_groups": ["customer"],
  "groups": {"business": "Operator", "details": "Plan"},
  "fields": [
    { "key": "operator_name", "group": "business", "label": "Operator or Retailer", "type": "text", "required": true, "max_length": 80, "prefill": "business.name" },
    { "key": "operator_address", "group": "business", "label": "Address (optional)", "type": "textarea", "required": false, "max_length": 200, "prefill": "business.address" },
    { "key": "gstin", "group": "registration", "label": "{tax_id} (optional)", "type": "text", "required": false, "max_length": 20, "prefill": "business.gstin" },
    { "key": "bill_number", "group": "document", "label": "Bill Number", "type": "text", "required": true, "max_length": 30 },
    { "key": "bill_date", "group": "document", "label": "Bill Date", "type": "date", "required": true },
    { "key": "customer_name", "group": "customer", "label": "Customer Name", "type": "text", "required": true, "max_length": 80 },
    { "key": "mobile_number", "group": "customer", "label": "Mobile Number", "type": "text", "required": true, "max_length": 15 },
    { "key": "plan_type", "group": "details", "label": "Plan Type", "type": "select", "options": ["Prepaid recharge", "Postpaid plan"], "required": true },
    { "key": "plan_name", "group": "details", "label": "Plan Name", "type": "text", "required": true, "max_length": 80 },
    { "key": "validity", "group": "details", "label": "Validity or Billing Period (optional)", "type": "text", "required": false, "max_length": 60 },
    { "key": "plan_charge", "group": "charges", "label": "Plan Charge ({currency})", "type": "number", "required": true, "min": 0 },
    { "key": "other_charges", "group": "charges", "label": "Other Charges ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "gst_percent", "group": "charges", "label": "{tax} (%) (optional)", "type": "tax_rate", "required": false },
    { "key": "payment_mode", "group": "payment", "label": "Paid by", "type": "select", "options": ["Cash", "UPI", "Card", "Bank transfer"], "required": true }
  ]
}

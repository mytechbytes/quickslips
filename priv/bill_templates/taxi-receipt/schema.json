{
  "slug": "taxi-receipt",
  "title": "Taxi Receipt Generator",
  "category": "Travel",
  "icon": "hero-map-pin",
  "number_field": "receipt_number",
  "summary": "Cab or auto trip receipt with fare, toll and GST.",
  "description": "Generate a taxi or auto-rickshaw receipt with pickup and drop, distance, fare, toll and GST. Preview instantly and download as PDF.",
  "templates": [{ "id": "t1", "name": "Classic" }],
  "fields": [
    { "key": "operator_name", "label": "Cab company or driver name", "type": "text", "required": true, "max_length": 80, "prefill": "business.name" },
    { "key": "operator_address", "label": "Address (optional)", "type": "textarea", "required": false, "max_length": 200, "prefill": "business.address" },
    { "key": "receipt_number", "label": "Receipt number", "type": "text", "required": true, "max_length": 30 },
    { "key": "date", "label": "Trip date", "type": "date", "required": true },
    { "key": "passenger_name", "label": "Passenger name (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "pickup", "label": "Pickup", "type": "text", "required": true, "max_length": 120 },
    { "key": "drop", "label": "Drop", "type": "text", "required": true, "max_length": 120 },
    { "key": "vehicle_number", "label": "Vehicle number (optional)", "type": "text", "required": false, "max_length": 20 },
    { "key": "distance_km", "label": "Distance (km)", "type": "number", "required": true, "min": 0.1 },
    { "key": "base_fare", "label": "Fare (₹)", "type": "number", "required": true, "min": 0 },
    { "key": "toll", "label": "Toll and parking (₹) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "tax_percent", "label": "GST (%) (optional)", "type": "number", "required": false, "min": 0, "max": 28 },
    { "key": "payment_mode", "label": "Paid by", "type": "select", "options": ["Cash", "UPI", "Card", "Bank transfer"], "required": true }
  ]
}

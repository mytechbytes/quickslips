{
  "slug": "taxi-receipt",
  "public_slug": "cab-bill-generator",
  "title": "Cab Bill Generator",
  "category": "Travel",
  "icon": "hero-map-pin",
  "number_field": "receipt_number",
  "summary": "Cab or auto trip bill with fare, toll and {tax}.",
  "description": "Generate a cab, taxi or auto-rickshaw bill with pickup and drop, distance, fare, toll and {tax}. Preview instantly and download as PDF.",
  "templates": [{ "id": "t1", "name": "Classic" }],
  "fields": [
    { "key": "operator_name", "group": "business", "label": "Cab company or driver name", "type": "text", "required": true, "max_length": 80, "prefill": "business.name" },
    { "key": "operator_address", "group": "business", "label": "Address (optional)", "type": "textarea", "required": false, "max_length": 200, "prefill": "business.address" },
    { "key": "receipt_number", "group": "document", "label": "Receipt number", "type": "text", "required": true, "max_length": 30 },
    { "key": "date", "group": "document", "label": "Trip date", "type": "date", "required": true },
    { "key": "passenger_name", "group": "customer", "label": "Passenger name (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "pickup", "group": "details", "label": "Pickup", "type": "text", "required": true, "max_length": 120 },
    { "key": "drop", "group": "details", "label": "Drop", "type": "text", "required": true, "max_length": 120 },
    { "key": "vehicle_number", "group": "details", "label": "Vehicle number (optional)", "type": "text", "required": false, "max_length": 20 },
    { "key": "distance_km", "group": "charges", "label": "Distance (km)", "type": "number", "required": true, "min": 0.1 },
    { "key": "base_fare", "group": "charges", "label": "Fare ({currency})", "type": "number", "required": true, "min": 0 },
    { "key": "toll", "group": "charges", "label": "Toll and parking ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "tax_percent", "group": "charges", "label": "{tax} (%) (optional)", "type": "tax_rate", "required": false },
    { "key": "payment_mode", "group": "payment", "label": "Paid by", "type": "select", "options": ["Cash", "UPI", "Card", "Bank transfer"], "required": true }
  ]
}

    { "key": "airport_charge", "group": "charges", "label": "Airport Pickup Charge ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "advance_paid", "group": "charges", "label": "Advance Paid ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "tax_percent", "group": "charges", "label": "{tax} (%) (optional)", "type": "tax_rate", "required": false },
    { "key": "payment_mode", "group": "payment", "label": "Paid by", "type": "select", "options": ["Cash", "UPI", "Card", "Bank transfer", "Online"], "required": true }
  ]

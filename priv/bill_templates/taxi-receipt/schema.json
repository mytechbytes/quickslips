    { "key": "driver_name", "group": "details", "label": "Driver Name (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "vehicle_number", "group": "details", "label": "Vehicle Number (optional)", "type": "text", "required": false, "max_length": 20 },
    { "key": "vehicle_model", "group": "details", "label": "Vehicle Model (optional)", "type": "text", "required": false, "max_length": 60 },

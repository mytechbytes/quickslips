{
  "slug": "grocery-bill",
  "public_slug": "grocery-bill-generator",
  "title": "Grocery Bill Generator",
  "category": "Food & shopping",
  "icon": "hero-shopping-cart",
  "number_field": "bill_number",
  "summary": "Items, quantities and totals.",
  "description": "Create a grocery bill with as many items as you need, quantities, prices, a discount and {tax}. Preview instantly and download as PDF.",
  "languages": ["en", "hi", "es", "de", "fr", "it", "pt", "zh", "ja"],
  "tax": { "default": "added", "es": "included", "de": "included", "fr": "included", "it": "included", "gb": "included", "jp": "included", "cn": "included" },
  "templates": [{ "id": "t1" }, { "id": "t2" }],
  "saved_groups": ["customer"],
  "fields": [
    { "key": "store_name", "group": "business", "label": "Store Name", "type": "text", "required": true, "max_length": 80, "prefill": "business.name" },
    { "key": "store_address", "group": "business", "label": "Address (optional)", "type": "textarea", "required": false, "max_length": 200, "prefill": "business.address" },
    { "key": "store_phone", "group": "business", "label": "Phone Number (optional)", "type": "text", "required": false, "max_length": 20 },
    { "key": "gstin", "group": "registration", "label": "{tax_id} (optional)", "type": "text", "required": false, "max_length": 20, "prefill": "business.gstin" },
    { "key": "fssai_number", "group": "registration", "label": "FSSAI licence no. (optional)", "type": "text", "required": false, "max_length": 14, "pattern": "^[0-9]{14}$", "countries": ["in"] },
    { "key": "bill_number", "group": "document", "label": "Bill Number", "type": "text", "required": true, "max_length": 30 },
    { "key": "date", "group": "document", "label": "Date", "type": "date", "required": true },
    { "key": "time", "group": "document", "label": "Time (optional)", "type": "time", "required": false },
    { "key": "transaction_id", "group": "document", "label": "Transaction ID (optional)", "type": "text", "required": false, "max_length": 40 },
    { "key": "customer_name", "group": "customer", "label": "Customer Name (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "items", "group": "items", "label": "Items", "type": "items", "required": true, "max_rows": 30, "name_max_length": 80,
      "cells": ["name", "qty", "rate", "discount"],
      "columns": { "name": "Item", "qty": "Qty", "rate": "Price ({currency})", "discount": "Disc. %" },
      "legacy": { "name": "item", "qty": "qty", "rate": "price", "count": 6 } },
    { "key": "discount", "group": "charges", "label": "Discount ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "tax_percent", "group": "charges", "label": "{tax} (%) (optional)", "type": "tax_rate", "required": false },
    { "key": "payment_mode", "group": "payment", "label": "Paid by", "type": "select", "options": ["Cash", "UPI", "Card", "Bank transfer", "Online"], "required": true }
  ]
}

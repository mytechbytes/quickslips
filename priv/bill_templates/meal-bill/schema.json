{
  "slug": "meal-bill",
  "public_slug": "meal-bill-generator",
  "title": "Meal Bill Generator",
  "category": "Food & shopping",
  "icon": "hero-shopping-bag",
  "number_field": "invoice_number",
  "summary": "Food-delivery tax invoice with {tax} on each line.",
  "description": "Generate a food-delivery or meal tax invoice on behalf of a restaurant, with the delivery address, tax on each line, the platform's legal details and a signatory. Preview instantly and download as PDF.",
  "languages": ["en", "hi", "es", "de", "fr", "it", "pt", "zh", "ja"],
  "tax": { "default": "added", "es": "included", "de": "included", "fr": "included", "it": "included", "gb": "included", "jp": "included", "cn": "included" },
  "templates": [{ "id": "t1" }],
  "saved_groups": ["customer"],
  "fields": [
    { "key": "brand_name", "group": "business", "label": "Platform or Brand Name (optional)", "type": "text", "required": false, "max_length": 40 },
    { "key": "legal_name", "group": "business", "label": "Legal Entity Name (optional)", "type": "text", "required": false, "max_length": 120 },
    { "key": "restaurant_name", "group": "business", "label": "Restaurant Name", "type": "text", "required": true, "max_length": 80, "prefill": "business.name" },
    { "key": "restaurant_address", "group": "business", "label": "Restaurant Address (optional)", "type": "textarea", "required": false, "max_length": 200, "prefill": "business.address" },
    { "key": "restaurant_gstin", "group": "registration", "label": "Restaurant {tax_id} (optional)", "type": "tax_id", "required": false, "max_length": 20, "prefill": "business.gstin" },
    { "key": "restaurant_fssai", "group": "registration", "label": "Restaurant FSSAI no. (optional)", "type": "text", "required": false, "max_length": 14, "pattern": "^[0-9]{14}$", "countries": ["in"] },
    { "key": "invoice_number", "group": "document", "label": "Invoice Number", "type": "text", "required": true, "max_length": 30 },
    { "key": "date", "group": "document", "label": "Invoice Date", "type": "date", "required": true },
    { "key": "order_id", "group": "document", "label": "Order ID (optional)", "type": "text", "required": false, "max_length": 30 },
    { "key": "customer_name", "group": "customer", "label": "Customer Name", "type": "text", "required": true, "max_length": 80 },
    { "key": "delivery_address", "group": "customer", "label": "Delivery Address (optional)", "type": "textarea", "required": false, "max_length": 250 },
    { "key": "place_of_supply", "group": "customer", "label": "State and place of supply (optional)", "type": "text", "required": false, "max_length": 60, "countries": ["in"] },
    { "key": "hsn_code", "group": "details", "label": "HSN Code (optional)", "type": "text", "required": false, "max_length": 10, "countries": ["in"] },
    { "key": "service_description", "group": "details", "label": "Service Description (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "items", "group": "items", "label": "Billing Rows", "type": "items", "required": true, "max_rows": 12, "name_max_length": 80,
      "cells": ["name", "rate", "discount", "tax"],
      "columns": { "name": "Particulars", "rate": "Gross value ({currency})", "discount": "Discount %", "tax": "Tax %" } },
    { "key": "reverse_charge", "group": "payment", "label": "Reverse Charge (optional)", "type": "select", "options": ["No", "Yes"], "required": false, "countries": ["in"] },
    { "key": "payment_note", "group": "payment", "label": "Payment Note (optional)", "type": "textarea", "required": false, "max_length": 200 },
    { "key": "platform_company", "group": "details", "label": "Platform company name and address (optional)", "type": "textarea", "required": false, "max_length": 250 },
    { "key": "platform_pan", "group": "details", "label": "Platform PAN (optional)", "type": "text", "required": false, "max_length": 10, "countries": ["in"] },
    { "key": "platform_cin", "group": "details", "label": "Platform CIN (optional)", "type": "text", "required": false, "max_length": 21, "countries": ["in"] },
    { "key": "platform_tax_id", "group": "details", "label": "Platform {tax_id} (optional)", "type": "tax_id", "required": false, "max_length": 20 },
    { "key": "platform_fssai", "group": "details", "label": "Platform FSSAI no. (optional)", "type": "text", "required": false, "max_length": 14, "pattern": "^[0-9]{14}$", "countries": ["in"] },
    { "key": "signatory_name", "group": "details", "label": "Signatory Name (optional)", "type": "text", "required": false, "max_length": 60 }
  ]
}

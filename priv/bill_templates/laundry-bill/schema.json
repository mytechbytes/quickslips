{
  "slug": "laundry-bill",
  "public_slug": "laundry-bill-generator",
  "title": "Laundry Bill Generator",
  "category": "Home & utilities",
  "icon": "hero-sparkles",
  "number_field": "invoice_number",
  "summary": "Laundry and dry-cleaning bill with garments, quantities and amounts.",

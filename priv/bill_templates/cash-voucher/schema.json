    { "key": "prepared_by", "group": "details", "label": "Prepared by", "type": "text", "required": true, "max_length": 60 },
    { "key": "checked_by", "group": "details", "label": "Checked by", "type": "text", "required": true, "max_length": 60 },
    { "key": "approved_by", "group": "details", "label": "Approved by", "type": "text", "required": true, "max_length": 60 },
    { "key": "resident_certificate", "group": "details", "label": "Resident certificate no. (optional)", "type": "text", "required": false, "max_length": 30 },
    { "key": "received_date", "group": "details", "label": "Date Received (optional)", "type": "date", "required": false },
    { "key": "place", "group": "details", "label": "Place (optional)", "type": "text", "required": false, "max_length": 60 }
  ]

    { "key": "date", "group": "document", "label": "Date", "type": "date", "required": true },
    { "key": "paid_to", "group": "customer", "label": "Paid to", "type": "text", "required": true, "max_length": 80 },
    { "key": "address", "group": "customer", "label": "Address", "type": "textarea", "required": true, "max_length": 200 },

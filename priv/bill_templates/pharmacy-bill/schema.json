{
  "slug": "pharmacy-bill",
  "public_slug": "pharmacy-bill-generator",
  "title": "Pharmacy Bill Generator",
  "category": "Health & learning",
  "icon": "hero-beaker",
  "number_field": "bill_number",
  "summary": "Medical store bill with batch, expiry and MRP.",
  "description": "Generate a pharmacy or chemist bill with medicines, manufacturer, batch, expiry and MRP, {tax} included in the price, a discount and the branch's licence details. Preview instantly and download as PDF.",
  "languages": ["en", "hi", "es", "de", "fr", "it", "pt", "zh", "ja"],
  "tax": { "default": "included", "us": "added", "br": "added", "ca": "added" },
  "templates": [{ "id": "t1" }],
  "saved_groups": ["customer"],
  "fields": [
    { "key": "brand_name", "group": "business", "label": "Pharmacy Name", "type": "text", "required": true, "max_length": 60, "prefill": "business.name" },
    { "key": "brand_subtitle", "group": "business", "label": "Tagline (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "branch_name", "group": "business", "label": "Branch (optional)", "type": "text", "required": false, "max_length": 60 },
    { "key": "branch_address", "group": "business", "label": "Branch Address (optional)", "type": "textarea", "required": false, "max_length": 200, "prefill": "business.address" },
    { "key": "toll_free", "group": "business", "label": "Phone (optional)", "type": "text", "required": false, "max_length": 30 },
    { "key": "website", "group": "business", "label": "Website (optional)", "type": "text", "required": false, "max_length": 60 },
    { "key": "dl_number", "group": "registration", "label": "Drug licence no. (optional)", "type": "text", "required": false, "max_length": 60 },
    { "key": "seller_tax_id", "group": "registration", "label": "{tax_id} (optional)", "type": "tax_id", "required": false, "max_length": 20, "prefill": "business.gstin" },
    { "key": "fssai", "group": "registration", "label": "FSSAI no. (optional)", "type": "text", "required": false, "max_length": 14, "pattern": "^[0-9]{14}$", "countries": ["in"] },
    { "key": "registered_office", "group": "registration", "label": "Registered Office (optional)", "type": "textarea", "required": false, "max_length": 200 },
    { "key": "admin_office", "group": "registration", "label": "Admin Office (optional)", "type": "textarea", "required": false, "max_length": 200 },
    { "key": "bill_number", "group": "document", "label": "Bill Number", "type": "text", "required": true, "max_length": 30 },
    { "key": "date", "group": "document", "label": "Date", "type": "date", "required": true },
    { "key": "time", "group": "document", "label": "Time (optional)", "type": "time", "required": false },
    { "key": "terminal_number", "group": "document", "label": "Terminal no. (optional)", "type": "text", "required": false, "max_length": 12 },
    { "key": "customer_name", "group": "customer", "label": "Customer Name", "type": "text", "required": true, "max_length": 80 },
    { "key": "ref_number", "group": "customer", "label": "Ref. no. (optional)", "type": "text", "required": false, "max_length": 30 },
    { "key": "doctor_name", "group": "customer", "label": "Doctor / Prescriber (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "items", "group": "items", "label": "Medicines", "type": "items", "required": true, "max_rows": 30, "name_max_length": 100, "cell_max_length": 24,
      "cells": ["name", "hsn", "mfr", "batch", "expiry", "schedule", "qty", "rate", "tax"],
      "columns": { "name": "Item name", "hsn": "HSN code", "mfr": "Mfr", "batch": "Batch no.", "expiry": "Expiry", "schedule": "Sch", "qty": "Qty", "rate": "MRP ({currency})", "tax": "Tax %" } },
    { "key": "discount", "group": "charges", "label": "Discount on the Total ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "payment_mode", "group": "payment", "label": "Payment", "type": "select", "options": ["Cash", "UPI", "Card", "Bank transfer", "Online"], "required": true },
    { "key": "signatory_name", "group": "payment", "label": "Signatory Name (optional)", "type": "text", "required": false, "max_length": 60 },
    { "key": "signatory_line", "group": "payment", "label": "Signatory Line (optional)", "type": "text", "required": false, "max_length": 60 }
  ]
}

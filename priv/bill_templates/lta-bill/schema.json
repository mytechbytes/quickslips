{
  "slug": "lta-bill",
  "public_slug": "leave-travel-allowance-bill-generator",
  "title": "Leave Travel Allowance Bill Generator",
  "category": "Travel",
  "icon": "hero-ticket",
  "number_field": "ticket_number",
  "summary": "Bus or train e-ticket for a leave travel allowance claim.",
  "description": "Create a bus or train e-ticket for a leave travel allowance (LTA) claim with the operator, boarding and dropping points, passengers, seat, fare, {tax} and the cancellation terms. Two designs; preview instantly and download as PDF.",
  "languages": ["en", "hi", "es", "de", "fr", "it", "pt", "zh", "ja"],
  "tax": { "default": "added", "es": "included", "de": "included", "fr": "included", "it": "included", "gb": "included", "jp": "included", "cn": "included" },
  "templates": [{ "id": "t1" }, { "id": "t2" }],
  "fields": [
    { "key": "travel_name", "group": "business", "label": "Travel operator", "type": "text", "required": true, "max_length": 80, "prefill": "business.name" },
    { "key": "boarding_phone", "group": "business", "label": "Boarding point phone", "type": "text", "required": true, "max_length": 20 },
    { "key": "customer_care", "group": "business", "label": "Customer care number", "type": "text", "required": true, "max_length": 20 },
    { "key": "seller_tax_id", "group": "registration", "label": "{tax_id} (optional)", "type": "tax_id", "required": false, "max_length": 20, "prefill": "business.gstin" },
    { "key": "ticket_number", "group": "document", "label": "Ticket number", "type": "text", "required": true, "max_length": 30 },
    { "key": "pnr_number", "group": "document", "label": "PNR number (optional)", "type": "text", "required": false, "max_length": 30 },
    { "key": "travel_type", "group": "details", "label": "Travel type", "type": "select", "options": ["Sleeper", "AC Sleeper", "Semi Sleeper", "AC Sleeper (2+1)", "Non Sleeper", "Non AC"], "required": true },
    { "key": "location", "group": "details", "label": "Boarding point: location", "type": "textarea", "required": true, "max_length": 120 },
    { "key": "landmark", "group": "details", "label": "Boarding point: landmark", "type": "textarea", "required": true, "max_length": 120 },
    { "key": "boarding_address", "group": "details", "label": "Boarding point: address", "type": "textarea", "required": true, "max_length": 200 },
    { "key": "reporting_date", "group": "details", "label": "Reporting date", "type": "date", "required": true },
    { "key": "departure_time", "group": "details", "label": "Departure time (optional)", "type": "time", "required": false },
    { "key": "dropping_date", "group": "details", "label": "Dropping point: date", "type": "date", "required": true },
    { "key": "dropping_time", "group": "details", "label": "Dropping point: time (optional)", "type": "time", "required": false },
    { "key": "dropping_address", "group": "details", "label": "Dropping point: address", "type": "textarea", "required": true, "max_length": 200 },
    { "key": "passenger_details", "group": "customer", "label": "Passenger name, age, gender", "type": "text", "required": true, "max_length": 200 },
    { "key": "passenger_count", "group": "customer", "label": "Number of passengers", "type": "text", "required": true, "max_length": 3, "pattern": "^[0-9]{1,3}$" },
    { "key": "seat_number", "group": "customer", "label": "Seat number", "type": "text", "required": true, "max_length": 30 },
    { "key": "amount", "group": "charges", "label": "Fare ({currency})", "type": "number", "required": true, "min": 0 },
    { "key": "tax_percent", "group": "charges", "label": "{tax} (%)", "type": "tax_rate", "required": false },
    { "key": "cancellation_charge", "group": "charges", "label": "Cancellation charge before departure ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "payment_mode", "group": "payment", "label": "Payment method", "type": "select", "options": ["Cash", "UPI", "Card", "Bank transfer", "Online"], "required": true }
  ]
}

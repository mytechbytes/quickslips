{
  "slug": "ecommerce-bill",
  "public_slug": "ecommerce-bill-generator",
  "title": "E-commerce Bill Generator",
  "category": "Food & shopping",
  "icon": "hero-shopping-bag",
  "number_field": "invoice_number",
  "summary": "Online order invoice with a tax rate per item and shipping.",
  "description": "Create an invoice for an online order with products, quantities, a {tax} rate for each item, shipping, the seller, the marketplace and the customer's addresses. Four designs; preview instantly and download as PDF.",
  "languages": ["en", "hi", "es", "de", "fr", "it", "pt", "zh", "ja"],
  "tax": { "default": "included", "us": "added", "br": "added", "ca": "added" },
  "templates": [{ "id": "t1" }, { "id": "t2" }, { "id": "t3" }, { "id": "t4" }],
  "saved_groups": ["customer"],
  "fields": [
    { "key": "seller_name", "group": "business", "label": "Sold by", "type": "text", "required": true, "max_length": 80, "prefill": "business.name" },
    { "key": "seller_address", "group": "business", "label": "Seller Address (optional)", "type": "textarea", "required": false, "max_length": 200, "prefill": "business.address" },
    { "key": "seller_phone", "group": "business", "label": "Seller Phone (optional)", "type": "text", "required": false, "max_length": 30 },
    { "key": "platform_name", "group": "business", "label": "Online Store or Marketplace (optional)", "type": "text", "required": false, "max_length": 60 },
    { "key": "platform_website", "group": "business", "label": "Website (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "seller_tax_id", "group": "registration", "label": "{tax_id} (optional)", "type": "tax_id", "required": false, "max_length": 20, "prefill": "business.gstin" },
    { "key": "invoice_number", "group": "document", "label": "Invoice Number", "type": "text", "required": true, "max_length": 30 },
    { "key": "date", "group": "document", "label": "Invoice Date", "type": "date", "required": true },
    { "key": "order_number", "group": "document", "label": "Order Number (optional)", "type": "text", "required": false, "max_length": 30 },
    { "key": "order_date", "group": "document", "label": "Order Date (optional)", "type": "date", "required": false },
    { "key": "customer_name", "group": "customer", "label": "Customer Name", "type": "text", "required": true, "max_length": 80 },
    { "key": "customer_phone", "group": "customer", "label": "Mobile Number (optional)", "type": "text", "required": false, "max_length": 20 },
    { "key": "shipping_address", "group": "customer", "label": "Shipping Address", "type": "textarea", "required": true, "max_length": 200 },
    { "key": "billing_address", "group": "customer", "label": "Billing Address (optional)", "type": "textarea", "required": false, "max_length": 200 },
    { "key": "items", "group": "items", "label": "Products", "type": "items", "required": true, "max_rows": 40, "name_max_length": 120,
      "cells": ["name", "qty", "rate", "tax"],
      "columns": { "name": "Description", "qty": "Qty", "rate": "Price ({currency})", "tax": "Tax %" } },
    { "key": "shipping_charge", "group": "charges", "label": "Shipping Charges ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "payment_mode", "group": "payment", "label": "Payment Method", "type": "select", "options": ["Cash", "UPI", "Card", "Bank transfer", "Online"], "required": true },
    { "key": "signatory_name", "group": "payment", "label": "Signatory Name (optional)", "type": "text", "required": false, "max_length": 60 },
    { "key": "return_policy", "group": "details", "label": "Return Policy and Notes (optional)", "type": "textarea", "required": false, "max_length": 600 }
  ]
}

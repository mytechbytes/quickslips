{
  "slug": "gym-membership-receipt",
  "public_slug": "gym-membership-receipt-generator",
  "title": "Gym Membership Receipt Generator",
  "category": "Health & learning",
  "icon": "hero-trophy",
  "number_field": "receipt_number",
  "summary": "Membership or monthly fee receipt.",
  "description": "Create a gym membership receipt with member, plan, validity dates, fee and GST. Preview instantly and download as PDF.",
  "tax": { "default": "added" },
  "templates": [{ "id": "t1", "name": "Classic" }],
  "fields": [
    { "key": "gym_name", "label": "Gym or fitness club", "type": "text", "required": true, "max_length": 80, "prefill": "business.name" },
    { "key": "gym_address", "label": "Address (optional)", "type": "textarea", "required": false, "max_length": 200, "prefill": "business.address" },
    { "key": "gstin", "label": "GSTIN (optional)", "type": "text", "required": false, "max_length": 15, "prefill": "business.gstin" },
    { "key": "receipt_number", "label": "Receipt number", "type": "text", "required": true, "max_length": 30 },
    { "key": "date", "label": "Receipt date", "type": "date", "required": true },
    { "key": "member_name", "label": "Member name", "type": "text", "required": true, "max_length": 80 },
    { "key": "member_phone", "label": "Member phone (optional)", "type": "text", "required": false, "max_length": 15 },
    { "key": "plan", "label": "Plan", "type": "select", "options": ["Day pass", "Monthly", "Quarterly", "Half-yearly", "Yearly"], "required": true },
    { "key": "start_date", "label": "Valid from", "type": "date", "required": true },
    { "key": "end_date", "label": "Valid till", "type": "date", "required": true },
    { "key": "fee", "label": "Membership fee (₹)", "type": "number", "required": true, "min": 0 },
    { "key": "joining_fee", "label": "Joining fee (₹) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "gst_percent", "label": "{tax} (%) (optional)", "type": "tax_rate", "required": false },
    { "key": "payment_mode", "label": "Paid by", "type": "select", "options": ["Cash", "UPI", "Card", "Bank transfer"], "required": true }
  ]
}

{
  "slug": "medical-bill",
  "public_slug": "medical-bill-generator",
  "title": "Medical Bill Generator",
  "category": "Health & learning",
  "icon": "hero-heart",
  "number_field": "bill_number",
  "summary": "Hospital, clinic or lab bill with {tax}.",
  "description": "Create a hospital, clinic or lab bill with patient, doctor, room, consultation, medicines, tests and itemised charges. Preview instantly and download as PDF.",
  "languages": ["en", "hi", "es", "de", "fr", "it", "pt", "zh", "ja"],
  "tax": { "default": "added" },
  "templates": [{ "id": "t1" }, { "id": "t2" }],
  "saved_groups": ["customer"],
  "fields": [
    { "key": "clinic_name", "group": "business", "label": "Hospital, Clinic or Lab", "type": "text", "required": true, "max_length": 80, "prefill": "business.name" },
    { "key": "clinic_address", "group": "business", "label": "Address (optional)", "type": "textarea", "required": false, "max_length": 200, "prefill": "business.address" },
    { "key": "clinic_phone", "group": "business", "label": "Contact Phone (optional)", "type": "text", "required": false, "max_length": 30 },
    { "key": "hospital_details", "group": "business", "label": "Hospital Details (optional)", "type": "textarea", "required": false, "max_length": 200 },
    { "key": "registration_number", "group": "registration", "label": "Registration Number (optional)", "type": "text", "required": false, "max_length": 30 },
    { "key": "bill_number", "group": "document", "label": "Bill Number", "type": "text", "required": true, "max_length": 30 },
    { "key": "date", "group": "document", "label": "Date", "type": "date", "required": true },
    { "key": "time", "group": "document", "label": "Time (optional)", "type": "time", "required": false },
    { "key": "admit_date", "group": "document", "label": "Admit Date (optional)", "type": "date", "required": false },
    { "key": "discharge_date", "group": "document", "label": "Discharge Date (optional)", "type": "date", "required": false },
    { "key": "patient_name", "group": "customer", "label": "Patient Name", "type": "text", "required": true, "max_length": 80 },
    { "key": "patient_details", "group": "customer", "label": "Age and Sex (optional)", "type": "text", "required": false, "max_length": 20 },
    { "key": "patient_issue", "group": "customer", "label": "Patient Issue (optional)", "type": "text", "required": false, "max_length": 120 },
    { "key": "guardian_name", "group": "customer", "label": "Guardian Name (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "patient_phone", "group": "customer", "label": "Patient Mobile (optional)", "type": "text", "required": false, "max_length": 20 },
    { "key": "patient_address", "group": "customer", "label": "Patient Address (optional)", "type": "textarea", "required": false, "max_length": 200 },
    { "key": "payer_name", "group": "customer", "label": "Payer Name (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "payer_address", "group": "customer", "label": "Payer Address (optional)", "type": "textarea", "required": false, "max_length": 200 },
    { "key": "doctor_name", "group": "details", "label": "Doctor (optional)", "type": "text", "required": false, "max_length": 80 },
    { "key": "doctor_designation", "group": "details", "label": "Designation (optional)", "type": "text", "required": false, "max_length": 60 },
    { "key": "room", "group": "details", "label": "Room Category (optional)", "type": "select", "options": ["Single", "Semi-private", "Private", "General", "ICU"], "required": false },
    { "key": "insurance", "group": "details", "label": "Insurance (optional)", "type": "select", "options": ["Yes", "No"], "required": false },
    { "key": "remark", "group": "details", "label": "Remark (optional)", "type": "textarea", "required": false, "max_length": 300 },
    { "key": "items", "group": "items", "label": "Itemised Charges", "type": "items", "required": false, "max_rows": 30, "name_max_length": 100,
      "columns": { "name": "Description", "qty": "Units", "rate": "Price ({currency})" } },
    { "key": "consultation_fee", "group": "charges", "label": "Consultation ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "medicines_cost", "group": "charges", "label": "Medicines ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "tests_cost", "group": "charges", "label": "Tests and Procedures ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "other_charges", "group": "charges", "label": "Other Charges ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "discount", "group": "charges", "label": "Discount ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "tax_percent", "group": "charges", "label": "{tax} (%) (optional)", "type": "tax_rate", "required": false },
    { "key": "amount_paid", "group": "charges", "label": "Amount Paid ({currency}) (optional)", "type": "number", "required": false, "min": 0 },
    { "key": "payment_mode", "group": "payment", "label": "Paid by", "type": "select", "options": ["Cash", "UPI", "Card", "Bank transfer", "Online"], "required": true }
  ]
}

{
  "slug": "fuel-bill",
  "category": "Travel",
  "icon": "hero-fire",
  "number_field": "bill_number",
  "languages": ["en", "hi", "es"],
  "templates": [{ "id": "t1" }],
  "fields": [
    { "key": "station_name", "type": "text", "required": true, "max_length": 80, "prefill": "business.name" },
    { "key": "station_address", "type": "textarea", "required": false, "max_length": 200, "prefill": "business.address" },
    { "key": "bill_number", "type": "text", "required": true, "max_length": 30 },
    { "key": "date", "type": "date", "required": true },
    { "key": "vehicle_number", "type": "text", "required": false, "max_length": 20 },
    { "key": "fuel_type", "type": "select", "options": ["Petrol", "Diesel", "CNG"], "required": true },
    { "key": "quantity", "type": "number", "required": true, "min": 0.01 },
    { "key": "rate", "type": "number", "required": true, "min": 0.01 }
  ]
}
